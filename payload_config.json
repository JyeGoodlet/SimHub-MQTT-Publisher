{
  "_comment": "Edit this file to control which fields are included in the MQTT payload. Remove a field name from EnabledFields to exclude it.",
  "PayloadRoot": {
    "EnabledFields": [ "time", "userId", "carState", "flagData" ]
  },
  "Car": {
    "EnabledFields": [
      "SpeedKmh",
      "Rpms",
      "Clutch",
      "Throttle",
      "Brake",
      "Gear",
      "CarCoordinates",
      "CurrentLapTime",
      "CarModel",
      "CarClass",
      "EngineIgnitionOn",
      "EngineStarted"
    ]
  },
  "FlagInformation": {
    "EnabledFields": [
      "Flag_Name",
      "Flag_Black",
      "Flag_Blue",
      "Flag_Checkered",
      "Flag_Yellow",
      "Flag_Green",
      "Flag_White",
      "Flag_Orange"
    ]
  },
  "TrackInformation": {
    "EnabledFields": [ "TrackId", "TrackConfig", "TrackCode", "TrackLength" ]
  },
  "VehicleInformation": {
    "EnabledFields": [ "CarModel", "CarClass", "CarId", "MaxRpm" ]
  }
}
